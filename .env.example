# Compose project / container
ROCKETCAT_CONTAINER_NAME=rocketcatshell
TZ=Asia/Shanghai

# WebUI publish settings
ROCKETCAT_WEBUI_BIND_IP=127.0.0.1
ROCKETCAT_WEBUI_HOST=0.0.0.0
ROCKETCAT_WEBUI_PORT=5751
ROCKETCAT_ONEBOT_PORT=6200
ROCKETCAT_WEBUI_PASSWORD=123456

# First-run shell defaults
ROCKETCAT_MESSAGE_INDEX_MAX_ENTRIES=1000
ROCKETCAT_LOG_LEVEL=INFO
ROCKETCAT_PERF_TRACE=false
ROCKETCAT_AUTO_OPEN_BROWSER=false
ROCKETCAT_DEFAULT_ONEBOT_WS_URL=ws://host.docker.internal:6200/ws/
ROCKETCAT_DEFAULT_ONEBOT_ACCESS_TOKEN=
ROCKETCAT_DEFAULT_RECONNECT_DELAY=5.0
ROCKETCAT_DEFAULT_MAX_RECONNECT_ATTEMPTS=10
ROCKETCAT_DEFAULT_ENABLE_SUBCHANNEL_SESSION_ISOLATION=true
ROCKETCAT_DEFAULT_REMOTE_MEDIA_MAX_SIZE=20971520
ROCKETCAT_DEFAULT_SKIP_OWN_MESSAGES=true
ROCKETCAT_DEFAULT_DEBUG=false
ROCKETCAT_NEXT_ONEBOT_SELF_ID=910001

# Persistent host paths
ROCKETCAT_CONFIG_DIR=./config
ROCKETCAT_BOTS_DIR=./data/bots
ROCKETCAT_PLUGINS_DIR=./data/plugins
ROCKETCAT_PLUGIN_DATA_DIR=./data/plugin_data
ROCKETCAT_LOGS_DIR=./logs
ROCKETCAT_SHARED_MEDIA_HOST_DIR=./data/bots/_shared_media
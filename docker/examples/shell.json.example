{
  "webui_host": "0.0.0.0",
  "webui_port": 5751,
  "webui_access_password": "123456",
  "message_index_max_entries": 1000,
  "performance_profile": "balanced",
  "inbound_worker_count": 0,
  "onebot_outgoing_queue_max_entries": 512,
  "identity_cache_max_entries": 4096,
  "media_cache_max_bytes": 1073741824,
  "media_cache_max_age_hours": 168,
  "log_file_max_bytes": 10485760,
  "log_file_backup_count": 3,
  "terminal_max_sessions": 6,
  "terminal_idle_timeout_seconds": 0,
  "log_level": "INFO",
  "auto_open_browser": false,
  "default_onebot_ws_url": "ws://host.docker.internal:6200/ws/",
  "default_onebot_access_token": "",
  "default_reconnect_delay": 5.0,
  "default_max_reconnect_attempts": 10,
  "default_enable_subchannel_session_isolation": true,
  "default_remote_media_max_size": 20971520,
  "default_skip_own_messages": true,
  "default_debug": false
}
